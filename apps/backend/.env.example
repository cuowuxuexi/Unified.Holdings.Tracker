# 数据库连接
# 重要：路径相对于 apps/backend/ 目录
# 标准路径：file:./prisma/data/portfolio.db
DATABASE_URL="file:./prisma/data/portfolio.db"

# 服务器配置
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
API_BASE_PATH=/api

# 告警配置 (可选)
# 每日快照/复测失败时推送事件的地址 (例如 OpenClaw webhook URL)
# SNAPSHOT_ALERT_WEBHOOK="https://your-webhook-endpoint.com"
