{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "bin": "dist/server.js",
  "pkg": {
    "assets": [
      "dist/**/*",
      "node_modules/axios/**/*",
      "node_modules/iconv-lite/**/*",
      "node_modules/date-fns/**/*"
    ],
    "targets": [
      "node18-win-x64",
      "node16-win-x64"
    ],
    "outputPath": "../release/backend",
    "outputName": "portfolio-backend.exe"
  },
  "scripts": {
    "test": "jest",
    "dev": "ts-node-dev --prefer-ts-exts --clear --respawn -r tsconfig-paths/register src/server.ts",
    "dev:build": "npm run build && node dist/server.js",
    "build": "rimraf dist && tsc",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "migrate:json": "ts-node --project tsconfig.scripts.json --transpile-only scripts/migrate-json-to-sqlite.ts",
    "diagnose:data": "ts-node --project tsconfig.scripts.json --transpile-only src/scripts/diagnoseData.ts",
    "verify:exchange-rate": "ts-node --project tsconfig.scripts.json --transpile-only src/scripts/verifyExchangeRate.ts",
    "start": "node dist/server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@types/node-schedule": "^2.1.8",
    "axios": "^1.8.4",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "iconv-lite": "^0.6.3",
    "multer": "^2.0.2",
    "node-cache": "^5.1.2",
    "node-schedule": "^2.1.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "xlsx": "^0.18.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.19.0",
    "@types/supertest": "^2.0.16",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "openapi-types": "^12.1.3",
    "prisma": "^6.19.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "uuid": "^11.1.0"
  }
}
