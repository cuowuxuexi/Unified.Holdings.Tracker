{
  "name": "v3",
  "private": true,
  "version": "1.0.0",
  "main": "index.js",
  "workspaces": [
    "backend",
    "frontend",
    "electron"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "build:electron": "npm run build -w electron",
    "watch:electron": "npm run watch -w electron",
    "start:electron": "npm run start:dist -w electron",
    "electron-dev": "concurrently \"npm:dev:backend\" \"npm:dev:frontend\" \"npm:watch:electron\" \"wait-on http://localhost:5173 http://localhost:3001 && npm run start:electron\"",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/node-schedule": "^2.1.7",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.5.3",
    "wait-on": "^8.0.3"
  }
