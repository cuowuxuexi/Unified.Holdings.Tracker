{
  "name": "v3",
  "private": true,
  "version": "1.0.0",
  "main": "index.js",
  "workspaces": [
    "apps/backend",
    "frontend",
    "electron",
    "packages/*"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:backend": "npm test -w backend",
    "dev": "concurrently \"npm:dev:backend\" \"npm:dev:frontend\" --names \"后端,前端\" --prefix-colors \"bgBlue,bgGreen\"",
    "dev:frontend": "cross-env NODE_ENV=development npm run dev -w frontend",
    "dev:backend": "cross-env NODE_ENV=development npm run dev -w backend",
    "prebuild:check": "node scripts/prebuild-check.js",
    "clean:build": "rimraf apps/backend/dist packages/*/dist electron/dist electron/renderer",
    "build:prisma": "npm run prisma:generate -w backend",
    "build:packages": "npm run build -w @uht/domain && npm run build -w @uht/application && npm run build -w @uht/infra",
    "build:backend": "npm run build -w backend",
    "build:frontend": "npm run build -w frontend",
    "build:electron": "npm run build -w electron",
    "build:all": "npm run build:prisma && npm run build:packages && npm run build:backend && npm run build:frontend && npm run build:electron",
    "build": "npm run prebuild:check && npm run clean:build && npm run build:all && npm run postbuild:verify",
    "postbuild:verify": "node scripts/postbuild-verify.js",
    "start:backend": "npm run build -w backend && npm run start -w backend",
    "watch:electron": "npm run watch -w electron",
    "start:electron": "npm run start:dist -w electron",
    "electron-dev": "concurrently \"npm:dev:backend\" \"npm:dev:frontend\" \"npm:watch:electron\" \"wait-on http://localhost:5173 http://localhost:3001 && cross-env NODE_ENV=development npm run start:electron\"",
    "electron-dev:safe": "node scripts/electron-dev-safe.js",
    "package": "npm run build && cd electron && npm run package",
    "make": "npm run build && cd electron && npm run make",
    "package:quick": "cd electron && npm run package",
    "clean": "rimraf frontend/node_modules/.vite apps/backend/dist packages/*/dist electron/dist electron/renderer **/*.tsbuildinfo",
    "clean:cache": "rimraf frontend/node_modules/.vite",
    "clean:dev": "node scripts/dev-cleanup.js",
    "clean:dev:status": "node scripts/dev-cleanup.js --status",
    "clean:dev:ports": "node scripts/dev-cleanup.js --ports",
    "clean:dev:node": "node scripts/dev-cleanup.js --node",
    "audit:pnl": "cross-env TS_NODE_PROJECT=tsconfig.base.json node -r ts-node/register scripts/audit-pnl.ts",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/node-schedule": "^2.1.7",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "electron-icon-builder": "^2.0.1",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.5.3",
    "rimraf": "^6.1.0",
    "wait-on": "^8.0.3"
  }
}
